FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# Production database (Railway Postgres). If unset, the app falls back to a
# local SQLite file (trialtracker.db) for development only.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email settings for reminders (SMTP or SendGrid SMTP) - set by the operator.
# Individual users never configure this; they just supply their email at signup.
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key
MAIL_FROM=notifications@example.com

# Protects the /tasks/run-reminders endpoint; use in your cron URL query string
REMINDER_TASK_TOKEN=long-random-token

FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# Production database (Railway Postgres). If unset, the app falls back to a
# local SQLite file (trialtracker.db) for development only.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email settings for reminders (Resend HTTPS API) - set by the operator.
# Individual users never configure this; they just supply their email at signup.
# Outbound SMTP is blocked on some hosting plans, so reminders are sent via
# Resend's HTTPS API rather than raw SMTP. MAIL_FROM must be on a domain
# verified in your Resend account.
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=notifications@example.com

# Protects the /tasks/run-reminders endpoint; sent as "Authorization: Bearer <token>"
REMINDER_TASK_TOKEN=long-random-token

# Optional: shown on the public /contact page. If unset, the page tells
# visitors to use the in-app support channel instead of showing an email.
# CONTACT_EMAIL=support@example.com

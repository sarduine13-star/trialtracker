FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-string

# Optional: override SQLite path (defaults to trialtracker.db in project folder)
# DATABASE_URL=sqlite:///trialtracker.db

# Email settings for reminders (SMTP or SendGrid SMTP)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key
MAIL_FROM=notifications@example.com

# Protects the /tasks/run-reminders endpoint; use in your cron URL query string
REMINDER_TASK_TOKEN=long-random-token

